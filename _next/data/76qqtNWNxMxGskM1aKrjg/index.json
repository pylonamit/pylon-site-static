rower experience"},{"text":"API-first, MCP-native infrastructure"},{"text":"Forward-deployed engineering support"}],"button_text":"See docs","button_url":"/developers"}],"code":[{"label":"Add borrower details","description":"Description","language":"graphql","request":"mutation createBorrower($input: CreateBorrowerInput!) {\r\n  borrower {\r\n    create(input: $input) {\r\n      id\r\n    }\r\n  }\r\n}","variables":"{\r\n  \"input\": {\r\n    \"dealId\": \"morwor_9874935789759837\",\r\n    \"personalInformation\": {\r\n      \"email\": \"alice@example.com\",\r\n      \"firstName\": \"Alice\",\r\n      \"lastName\": \"Firstimer\",\r\n      \"phoneNumber\": {\r\n        \"number\": \"111-111-1111\",\r\n        \"type\": \"CELL\"\r\n      }\r\n    },\r\n    \"pointOfContact\": true\r\n  }\r\n}","response":"{\r\n  \"data\": {\r\n    \"borrower\": {\r\n      \"create\": {\r\n        \"id\": \"borr_opD3k3gX89jfSw3gGqMpqy\"\r\n      }\r\n    }\r\n  },\r\n  \"extensions\": {\r\n    \"complexity\": {\r\n      \"requestedQueryComplexity\": 10,\r\n      \"maxQueryComplexity\": 500\r\n    }\r\n  }\r\n}"},{"label":"Run preapproval","language":"graphql","request":"mutation runPreapproval ($input:RunLoanPreApprovalInput!){\r\n  preApproval {\r\n    runLoanPreApproval (input:$input) {\r\n      preApprovalRun {\r\n        ...on ApprovedPreApprovalRun {\r\n          id\r\n          loanAmount\r\n          salesContractAmount\r\n          __typename\r\n        }\r\n        ...on DeclinedPreApprovalRun {\r\n          id\r\n          ineligibleProducts {\r\n            product {\r\n              description\r\n              type\r\n              __typename\r\n            }\r\n            details {\r\n              ...on DebtToIncomeViolation {\r\n                dti\r\n                dtiLimit\r\n                __typename\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n}","variables":"{\r\n  \"input\": {\r\n    \"loanId\": \"app_873264823764378648237\"\r\n\t}\r\n}","response":"{\r\n  \"data\": {\r\n    \"preApproval\": {\r\n      \"runLoanPreApproval\": {\r\n        \"preApprovalRun\": {\r\n          \"id\": \"app_873264823764378648237\",\r\n          \"loanAmount\": 1249125,\r\n          \"salesContractAmount\": 1649125\r\n        }\r\n      }\r\n    }\r\n  },\r\n  \"extensions\": {\r\n    \"complexity\": {\r\n      \"requestedQueryComplexity\": 14,\r\n      \"maxQueryComplexity\": 500\r\n    }\r\n  }\r\n}"},{"label":"Run pricing","language":"graphql","request":"query getOptimalStructure($id: ID!) {\r\n  pricing {\r\n    optimalStructure(id: $id) {\r\n      id\r\n      status\r\n      result {\r\n        id\r\n        apr\r\n        rate\r\n        closingCosts\r\n        monthlyPayment\r\n        downPaymentAmount\r\n        cashFromToBorrower\r\n        dti\r\n        ltv\r\n        totalCost\r\n        totalPoints\r\n        product {\r\n          id\r\n          description\r\n          type\r\n        }\r\n      }\r\n    }\r\n  }\r\n}","variables":"{\r\n\t\"id\": \"job_KseqnzKcpVNeLsZF3xXrhZ\"\r\n}","response":"{\r\n  \"data\": {\r\n    \"pricing\": {\r\n      \"optimalStructure\": {\r\n        \"id\": \"job_kjhhKJHkjhdsfjh143\",\r\n        \"status\": \"SUCCEEDED\",\r\n        \"result\": {\r\n          \"apr\": 5.532,\r\n          \"rate\": 5.49,\r\n          \"closingCosts\": 0,\r\n          \"monthlyPayment\": 4242.68,\r\n          \"downPaymentAmount\": 60000,\r\n          \"cashFromToBorrower\": -60000,\r\n          \"dti\": 0.106,\r\n          \"ltv\": 0.9,\r\n          \"totalCost\": -11372.4,\r\n          \"totalPoints\": -2.106,\r\n          \"product\": {\r\n            \"description\": \"Pylon Conforming\",\r\n            \"type\": \"Conventional conforming\"\r\n          }\r\n        }\r\n      }\r\n    }\r\n  },\r\n  \"extensions\": {\r\n    \"complexity\": {\r\n      \"requestedQueryComplexity\": 4,\r\n      \"maxQueryComplexity\": 500\r\n    }\r\n  }\r\n}"},{"label":"Lock your ra